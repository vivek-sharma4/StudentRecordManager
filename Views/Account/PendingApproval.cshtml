@{
    ViewData["Title"] = "Account Pending Approval - Student Record Manager";
    var pendingEmail = ViewBag.PendingEmail as string ?? "your email address";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <div class="card-body p-5">
                    <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning mb-4">
                        <svg width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z" />
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z" />
                        </svg>
                    </div>

                    <h3 class="fw-bold text-dark mb-2">Registration Submitted</h3>
                    <h5 class="text-warning-emphasis fw-semibold mb-3">Pending Administrator Approval</h5>

                    <p class="text-secondary mb-4 leading-relaxed">
                        Thank you for registering <strong>@pendingEmail</strong>. To maintain the confidentiality of academic and student records, newly created accounts require authorization by a system administrator.
                    </p>

                    <div class="bg-light p-3 rounded-3 text-start small text-muted mb-4 border">
                        <h6 class="fw-bold text-dark mb-2">What happens next?</h6>
                        <ul class="ps-3 mb-0">
                            <li>An administrator will review your account authorization request.</li>
                            <li>Once approved, your account status will be activated.</li>
                            <li>You will then be able to log in and access the Student Management Portal.</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-center">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">
                            Return to Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>