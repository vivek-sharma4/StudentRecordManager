@model IEnumerable<StudentRecordManager.Models.Student>

<div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Roll No</th>
                <th>Department</th>
                <th>Marks</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Any())
            {
                foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentID</td>
                        <td>@student.Name</td>
                        <td>@student.RollNo</td>
                        <td>@student.Department</td>
                        <td>@student.Marks</td>
                        <td>
                            <button type="button" class="btn btn-warning btn-sm js-edit"
                                    data-id="@student.StudentID">Edit</button>

                            <button type="button" class="btn btn-danger btn-sm js-delete"
                                    data-id="@student.StudentID">Delete</button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">No student records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>