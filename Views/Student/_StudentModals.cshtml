@using Microsoft.AspNetCore.Mvc.Rendering

@{
    bool isAdmin = ViewBag.IsAdmin == true;
}

<!-- Add / Edit modal -->
<div class="modal fade" id="studentModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false"
     aria-labelledby="studentModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="studentForm" novalidate>
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="studentModalTitle">Add Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="StudentID" value="0" />

                    <div class="alert alert-danger d-none js-form-error" role="alert"></div>

                    <div class="mb-3">
                        <label for="fieldName" class="form-label">Name</label>
                        <input type="text" id="fieldName" name="Name" class="form-control" maxlength="100" />
                        <div class="invalid-feedback" data-error-for="Name"></div>
                    </div>

                    <div class="mb-3">
                        <label for="fieldRollNo" class="form-label">Roll No</label>
                        <input type="text" id="fieldRollNo" name="RollNo" class="form-control" maxlength="50" />
                        <div class="invalid-feedback" data-error-for="RollNo"></div>
                    </div>

                    <div class="mb-3">
                        <label for="fieldDepartment" class="form-label">Department</label>
                        @if (isAdmin)
                        {
                            <select id="fieldDepartment" name="Department" class="form-select"
                                    asp-items="@(ViewBag.Departments as IEnumerable<SelectListItem>)">
                                <option value="">Select department</option>
                            </select>
                        }
                        else
                        {
                            <input type="text" id="fieldDepartment" name="Department"
                                   class="form-control" readonly value="@ViewBag.CurrentDepartment" />
                        }
                        <div class="invalid-feedback" data-error-for="Department"></div>
                    </div>

                    <div class="mb-3">
                        <label for="fieldMarks" class="form-label">Marks</label>
                        <input type="number" id="fieldMarks" name="Marks" class="form-control"
                               step="0.01" min="0" max="100" />
                        <div class="invalid-feedback" data-error-for="Marks"></div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveStudent">Add Student</button>
                </div>

            </div>
        </form>
    </div>
</div>

<!-- Delete modal -->
<div class="modal fade" id="deleteModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false"
     aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form id="deleteForm" novalidate>
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalTitle">Delete Student</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="0" />

                    <div class="alert alert-danger d-none js-form-error" role="alert"></div>

                    <p>Are you sure you want to delete this student? This action cannot be undone.</p>

                    <dl class="row mb-0">
                        <dt class="col-sm-4">Student ID</dt>
                        <dd class="col-sm-8" data-field="id"></dd>

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8" data-field="name"></dd>

                        <dt class="col-sm-4">Roll No</dt>
                        <dd class="col-sm-8" data-field="rollNo"></dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8" data-field="department"></dd>

                        <dt class="col-sm-4">Marks</dt>
                        <dd class="col-sm-8" data-field="marks"></dd>
                    </dl>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="btnConfirmDelete">Delete Student</button>
                </div>

            </div>
        </form>
    </div>
</div>