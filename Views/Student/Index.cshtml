@model IEnumerable<StudentRecordManager.Models.Student>

@{
    ViewData["Title"] = "Student Records";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Student Records</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Student
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    
    <form asp-controller="Student" asp-action="Index" method="get">

        <div class="row align-items-start">

            <div class="col-md-4">
                <input type="text"
                       name="department"
                       value="@ViewBag.Department"
                       class="form-control"
                       placeholder="Search by department"
                       minlength="3" />

                @if (ViewData.ModelState["Department"]?.Errors.Count > 0)
                {
                    <span class="text-danger">
                        @ViewData.ModelState["Department"]?.Errors[0].ErrorMessage
                    </span>
                }
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-controller="Student"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Clear
                </a>
            </div>

        </div>

    </form>


    <table class="table table-bordered table-striped">

        <thead class="table-dark">
            <tr>
                <th>Student ID</th>
                <th>Name</th>
                <th>Roll No</th>
                <th>Department</th>
                <th>Marks</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            @if (Model.Any())
            {
                foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentID</td>
                        <td>@student.Name</td>
                        <td>@student.RollNo</td>
                        <td>@student.Department</td>
                        <td>@student.Marks</td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@student.StudentID"
                               class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@student.StudentID"
                               class="btn btn-danger btn-sm">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No student records found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>